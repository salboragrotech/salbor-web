# Copia este archivo como ".env" y ajusta la URL según dónde corra tu API.
# En desarrollo local, con la API corriendo con "npm run dev" en salbor-api:
VITE_API_URL=http://localhost:3000/api

# En producción, cuando despliegues la API (ej. a Render o Railway), cámbiala por su URL pública:
# VITE_API_URL=https://salbor-api.onrender.com/api
